[Unit]
Description=AgroTerra Gunicorn Daemon
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/root/agroterra/agroRent
EnvironmentFile=/root/agroterra/.env
ExecStart=/root/agroterra/venv/bin/gunicorn \
          --bind 0.0.0.0:5050 \
          --workers 3 \
          --timeout 60 \
          agroRent.wsgi:application
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
