# Bu faylni .env nomi bilan nusxalang va qiymatlarni to'ldiring. .env git'ga qo'shilmaydi.
# Serverda: /opt/agrorent/app/.env (egasi agrorent, ruxsat 600)

# Yangi kalit yaratish:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Ixtiyoriy: berilsa, admin panel login'dan tashqari /admin/?access=<kalit> ni ham talab qiladi.
# Bo'sh qolsa, superadmin login'ining o'zi yetarli.
ADMIN_ACCESS_KEY=

# Productionda False bo'lishi shart
DEBUG=False
ALLOWED_HOSTS=agrorent.uz,www.agrorent.uz
CSRF_TRUSTED_ORIGINS=https://agrorent.uz,https://www.agrorent.uz

# Baza va yuklangan fayllar repo tashqarisida saqlanadi
SQLITE_PATH=/opt/agrorent/data/db.sqlite3
MEDIA_ROOT=/opt/agrorent/media

# Tarjimalar keshi (barcha workerlar uchun umumiy)
CACHE_DIR=/opt/agrorent/cache

# Foydalanuvchi ma'lumotlarini Google orqali avtomatik tarjima qilish (standart: o'chiq)
AUTO_TRANSLATE=False
